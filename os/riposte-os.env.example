# Site values for the os/ scripts. Copy to /etc/riposte-os.env (or point RIPOSTE_OS_ENV at a
# copy) and fill in your own. Never commit the filled-in file: the repo is public.
RIPOSTE_RELEASE_URL=https://releases.example.net     # serves the launcher, suite/ and car-update/
RIPOSTE_SHARE=/srv/share/carlauncher                  # the project folder on the share
RIPOSTE_SHARE_HOST=user@share.example.net             # how the bench laptop reaches the share
RIPOSTE_BENCH_SRC=user@share.example.net:/srv/share/carlauncher/os/0.2-bench/   # flash-0.2.sh rsync source
RIPOSTE_BENCH_HOST=user@bench-laptop                  # the laptop at the bench
RIPOSTE_UNIT_ADB=192.0.2.14:5555                      # the head unit on home Wi-Fi
RIPOSTE_CAR_ADB=192.0.2.15:5555                       # the head unit over the car's uplink
RIPOSTE_ZERO=user@bench-laptop                        # where road noise takes are collected
RIPOSTE_WEBROOT=/var/www/releases                     # the release host's webroot, seen from here
RIPOSTE_BUILD_ADB=adb                                 # the build host's adb
RIPOSTE_ZLINK_STAGE=/var/tmp/zlink                    # a folder that adb can push from
RIPOSTE_CARPLAY_PSK=change-me                         # the unit's CarPlay access point password
