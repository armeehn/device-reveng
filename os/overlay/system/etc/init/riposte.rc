# Riposte OS first-boot hook. Runs once per /data, after the framework is up.
service riposte_firstboot /system/bin/sh /system/bin/riposte-firstboot.sh
    class late_start
    user shell
    group shell
    seclabel u:r:shell:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start riposte_firstboot

# Bench aid on car-owner builds: adb on the 4PIN USB while the boot animation runs, so a
# framework that never comes up still yields logcat. The vendor forces the port to host at
# animation start and again at boot_completed; this flips it back to peripheral in between.
service riposte_usbadb /system/bin/sh /system/bin/riposte-usbadb.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:service.bootanim.exit=0
    start riposte_usbadb

# Car-owner builds: the MCU serial line behind a loopback socket for McuOwner (see props).
service riposte_mcubridge /system/bin/sh /system/bin/riposte-mcubridge.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    disabled

on boot && property:ro.riposte.os.car_owner=1
    start riposte_mcubridge

# Car-owner builds: the OEM projection daemon for CarPlay (see riposte-zlink.sh). It redials
# the projection app every ten seconds, so the order of the two does not matter.
service riposte_zlink /system/bin/sh /system/bin/riposte-zlink.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1 && property:ro.riposte.os.car_owner=1
    start riposte_zlink
    start riposte_hotspot

# Car-owner builds: the 5 GHz access point wireless CarPlay needs (see riposte-hotspot.sh).
service riposte_hotspot /system/bin/sh /system/bin/riposte-hotspot.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    disabled

# Car-owner builds: keep /dev/zxw_io open the way eventcenter's GetTouchEvt thread does on
# stock (EventService.java startGetTouchEvtThread). The vendor's zxw_io driver may gate the
# touch path on an open reader; 0.2 without it never sees a touch interrupt (RAV4-84).
service riposte_zxwio /system/bin/sh /system/bin/riposte-zxwio.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    disabled

# The Goodix chip scales X (across the width) to 0..720 and Y (down the height) to 0..1920
# under a driver that advertises the reverse; the vendor framework coped, AOSP does not.
# riposte-touchswap grabs the driver's device and re-emits every event on a uinput touchscreen
# with the real ranges. Without it every touch arrives in the left third.
service riposte_touchswap /system/bin/riposte-touchswap
    class core
    user root
    group root input
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1 && property:ro.riposte.os.car_owner=1
    start riposte_touchswap
    start riposte_zxwio

# ro.riposte.os.bench=1 only: take the port back after the vendor's boot_completed host write.
on property:sys.boot_completed=1 && property:ro.riposte.os.bench=1
    start riposte_usbadb
