# Riposte OS first-boot hook. Runs once per /data, after the framework is up.
service riposte_firstboot /system/bin/sh /system/bin/riposte-firstboot.sh
    class late_start
    user shell
    group shell
    seclabel u:r:shell:s0
    oneshot
    disabled

on property:sys.boot_completed=1
    start riposte_firstboot

# Bench aid on car-owner builds: adb on the 4PIN USB while the boot animation runs, so a
# framework that never comes up still yields logcat. The vendor forces the port to host at
# animation start and again at boot_completed; this flips it back to peripheral in between.
service riposte_usbadb /system/bin/sh /system/bin/riposte-usbadb.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:service.bootanim.exit=0
    start riposte_usbadb

# Car-owner builds: the MCU serial line behind a loopback socket for McuOwner (see props).
service riposte_mcubridge /system/bin/sh /system/bin/riposte-mcubridge.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    disabled

on boot && property:ro.riposte.os.car_owner=1
    start riposte_mcubridge

# Car-owner builds: the OEM projection daemon for CarPlay (see riposte-zlink.sh). It redials
# the projection app every ten seconds, so the order of the two does not matter.
service riposte_zlink /system/bin/sh /system/bin/riposte-zlink.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1 && property:ro.riposte.os.car_owner=1
    start riposte_zlink
    start riposte_hotspot

# Car-owner builds: the 5 GHz access point wireless CarPlay needs (see riposte-hotspot.sh).
service riposte_hotspot /system/bin/sh /system/bin/riposte-hotspot.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    disabled

# Car-owner builds: keep /dev/zxw_io open the way eventcenter's GetTouchEvt thread does on
# stock (EventService.java startGetTouchEvtThread). The vendor's zxw_io driver may gate the
# touch path on an open reader; 0.2 without it never sees a touch interrupt (RAV4-84).
service riposte_zxwio /system/bin/sh /system/bin/riposte-zxwio.sh
    class core
    user root
    group root
    seclabel u:r:su:s0
    disabled

# The Goodix chip scales X (across the width) to 0..720 and Y (down the height) to 0..1920
# under a driver that advertises the reverse; the vendor framework coped, AOSP does not.
# riposte-touchswap grabs the driver's device and re-emits every event on a uinput touchscreen
# with the real ranges. Without it every touch arrives in the left third.
service riposte_touchswap /system/bin/riposte-touchswap
    class core
    user root
    group root input
    seclabel u:r:su:s0
    disabled

# Car-owner builds: the always-on diagnostics recorder (riposte-diag.sh), read back with
# `rav4 car diag pull` and os/diag/check.py.
service riposte_diag /system/bin/sh /system/bin/riposte-diag.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1 && property:ro.riposte.os.car_owner=1
    start riposte_touchswap
    start riposte_zxwio
    start riposte_diag

# Car-owner builds: one property picks the USB controller's role (riposte-usb-role.sh, the
# #279 camera-mode pattern): persist.riposte.usb.role=host|peripheral, set by the launcher's
# root shell; unset means the image default, peripheral on ro.riposte.os.bench=1 and host
# otherwise. The boot run (`boot`) waits out the vendor's boot_completed host write, which is
# what the bench-only trigger this replaces used riposte-usbadb.sh to undo. A persisted prop
# replays at boot, so the choice survives a reboot.
service riposte_usbrole /system/bin/sh /system/bin/riposte-usb-role.sh boot
    class main
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1 && property:ro.riposte.os.car_owner=1
    start riposte_usbrole

on property:persist.riposte.usb.role=* && property:ro.riposte.os.car_owner=1
    exec_background u:r:su:s0 root -- /system/bin/sh /system/bin/riposte-usb-role.sh

# Car-owner builds: the launcher's root grant, every boot (riposte-root.sh). sudaemon is
# class main, so it is up by boot_completed; the script seeds its allow row when missing and
# logs `riposte-root: launcher granted` or the reason it is not.
service riposte_root /system/bin/sh /system/bin/riposte-root.sh
    class main
    user root
    group root
    seclabel u:r:su:s0
    oneshot
    disabled

on property:sys.boot_completed=1 && property:ro.riposte.os.car_owner=1
    start riposte_root

# Car-owner builds: one property drives the reverse-camera decoder (riposte-camera-mode.sh,
# values 0..8 documented there). A persisted prop replays at boot, so the mode survives a
# reboot. The nodes are root-only, hence the su label, the same route TrebleDroid's
# persist.sys.phh.* handlers take (vndk.rc).
on property:persist.riposte.camera.mode=* && property:ro.riposte.os.car_owner=1
    exec_background u:r:su:s0 root -- /system/bin/sh /system/bin/riposte-camera-mode.sh

# Car-owner builds: the Qualcomm AIS camera server the reverse picture rides on, lifted by
# build.sh step 3d from the stock system image. Stock runs it as /system/bin/ais_server, class
# core, root, from boot_completed (init.target.rc:520-532); the GSI has no such binary, so the
# vendor's own `start ais_server` fails silently there. setenv: its libais_* and libmmosal.so
# sit beside it, and a /system daemon's linker namespace never searches /vendor/lib64. su
# rather than stock's u:r:ais_server:s0 (init.target.rc:524): the vendor policy carries no
# media-node or client-socket rules for that domain (vendor_sepolicy.cil:2789-2792), su is
# the permissive domain every other riposte service runs in.
service riposte_ais /system/riposte/ais/bin/ais_server
    class main
    user root
    group root camera
    setenv LD_LIBRARY_PATH /system/riposte/ais/lib
    seclabel u:r:su:s0
    disabled

on property:sys.boot_completed=1 && property:ro.riposte.os.car_owner=1
    start riposte_ais
