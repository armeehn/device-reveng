+static void s6d7aa0_yuntang_init(struct s6d7aa0 *ctx, struct mipi_dsi_multi_context *dsi_ctx)
+{
+	s6d7aa0_lock(ctx, dsi_ctx, false);	/* f0 5a 5a, f1 5a 5a, fc a5 a5 */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MCS_OTP_RELOAD, 0x00, 0x10);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb1, 0x01, 0x80);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb2, 0x14, 0x22, 0x2f, 0x04);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf2, 0x02, 0x10, 0x10, 0x40, 0x10);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf3, 0x01, 0x97, 0x20, 0x22, 0x80, 0x07, 0x25, 0x18, 0x22, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf4, 0x02, 0x02, 0x1c, 0x26, 0x1d, 0x02, 0x03, 0x03, 0x03, 0x1c, 0x1c, 0x03, 0x00, 0x0c, 0x0c, 0x03, 0x02, 0x03, 0x06, 0x06, 0x13, 0x14, 0x01, 0x15, 0x01, 0x04, 0xd2, 0x61, 0x78, 0x79, 0x72, 0xe3, 0xf3, 0xf0, 0x00, 0x00, 0x01, 0x01, 0x28, 0x04, 0x03, 0x28, 0x01, 0xd1, 0x32);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf5, 0x50, 0x3e, 0x3a, 0x5f, 0x7b, 0xb8, 0x7f, 0x0f, 0x33, 0x33, 0x03, 0x59, 0x54, 0x52, 0x45, 0x46, 0x60, 0x02, 0x60, 0x80, 0x27, 0x26, 0x52, 0x25, 0x7a, 0x1f);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xee, 0x0b, 0x00, 0x29, 0x00, 0x0b, 0x00, 0x29, 0x00);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xef, 0x23, 0x01, 0x10, 0x32, 0x60, 0x01, 0x24, 0x80);
