+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xe1, 0x03, 0x10, 0x1c, 0xa0, 0x10);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfd, 0x16, 0x10, 0x11, 0x23, 0x09);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfe, 0x00, 0x0d, 0x03, 0x21, 0x80, 0x78);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf6, 0x60, 0x21, 0xa6, 0x00, 0x00, 0x00);
+	/* gamma: b0 selects the bank, fa/fb carry positive/negative curves */
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x22);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfa, 0x15, 0x33, 0x1c, 0x22, 0x12, 0x17, 0x1b, 0x1b, 0x1b, 0x22, 0x24, 0x24, 0x24, 0x23, 0x26, 0x25, 0x2a);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x22);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfb, 0x15, 0x37, 0x1c, 0x26, 0x20, 0x23, 0x28, 0x26, 0x26, 0x2c, 0x2d, 0x2b, 0x2c, 0x2c, 0x29, 0x28, 0x2e);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x11);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfa, 0x15, 0x33, 0x18, 0x1f, 0x15, 0x1b, 0x20, 0x1f, 0x20, 0x26, 0x27, 0x26, 0x27, 0x25, 0x24, 0x23, 0x2a);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb0, 0x11);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfb, 0x15, 0x37, 0x1d, 0x21, 0x18, 0x1c, 0x21, 0x1f, 0x1f, 0x25, 0x27, 0x26, 0x27, 0x26, 0x26, 0x25, 0x2e);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfa, 0x22, 0x33, 0x25, 0x24, 0x19, 0x1f, 0x21, 0x1f, 0x1f, 0x25, 0x26, 0x25, 0x26, 0x22, 0x25, 0x23, 0x2b);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xfb, 0x22, 0x37, 0x25, 0x28, 0x1c, 0x21, 0x25, 0x23, 0x23, 0x29, 0x2a, 0x29, 0x2a, 0x27, 0x26, 0x24, 0x2d);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MCS_BL_CTL, 0x40, 0x00, 0x28);
+	mipi_dsi_dcs_set_tear_on_multi(dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_msleep(dsi_ctx, 100);
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 100);
+	/* display on (stock waits 50 ms after) is sent by s6d7aa0_on() */
+}
