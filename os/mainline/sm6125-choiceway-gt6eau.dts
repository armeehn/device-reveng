// SPDX-License-Identifier: BSD-3-Clause
/*
 * Choiceway GT6-EAU car head unit (Fibocom SC820/QCM6125), derived from
 * sm6125-xiaomi-ginkgo.dts by Gabriel Gonzales <semfault@disroot.org>.
 */

/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/firmware/qcom,scm.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include <dt-bindings/soc/qcom,apr.h>
#include <dt-bindings/sound/qcom,q6afe.h>
#include <dt-bindings/sound/qcom,q6asm.h>
#include "sm6125.dtsi"
#include "pm6125.dtsi"

/ {
	model = "Choiceway GT6-EAU";
	compatible = "choiceway,gt6-eau", "qcom,sm6125";
	chassis-type = "embedded";

	/* required for bootloader to select correct board */
	/*
	 * ABL must see an exact match for this board, or it applies the unit's downstream dtbo
	 * overlay to this DTB, fails ("Dtb overlay failed") and drops back to fastboot (bench,
	 * 2026-10-07). These are the car overlay's own IDs: QCM6125 (0x1d3) rev 1.0, board 0x22
	 * subtype 0; ABL then logs "Exact DTB match found. DTBO search is not required".
	 */
	qcom,msm-id = <0x1d3 0x10000>;
	qcom,board-id = <0x22 0>;

	aliases {
		serial1 = &mcu_uart;
		serial2 = &bt_uart;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			reg = <0 0x5c000000 0 (1920 * 720 * 4)>;
			width = <1920>;
			height = <720>;
			stride = <(1920 * 4)>;
			format = "a8r8g8b8";
		};
	};

	panel_avdd: regulator-panel-avdd {
		compatible = "regulator-fixed";
		regulator-name = "panel_avdd";
		gpio = <&tlmm 95 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <5000>;
	};

	panel_vmipi: regulator-panel-vmipi {
		compatible = "regulator-fixed";
		regulator-name = "panel_vmipi";
		gpio = <&tlmm 84 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <5000>;
	};

	/*
	 * Stock: 12-bit levels on the PM6125 LPG, 100 us period, enable on GPIO 97.
	 * The default is half brightness; the stock 102/4095 reads as off in daylight.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pm6125_pwm 0 100000>;
		enable-gpios = <&tlmm 97 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 4095>;
		num-interpolated-steps = <4095>;
		default-brightness-level = <2048>;
	};

	reserved-memory {
		debug_mem: debug@ffb00000 {
			reg = <0x0 0xffb00000 0x0 0xc0000>;
			no-map;
		};

		last_log_mem: lastlog@ffbc0000 {
			reg = <0x0 0xffbc0000 0x0 0x80000>;
			no-map;
		};

		pstore_mem: ramoops@ffc00000 {
			compatible = "ramoops";
			reg = <0x0 0xffc40000 0x0 0xc0000>;
			record-size = <0x1000>;
			console-size = <0x40000>;
			pmsg-size = <0x20000>;
		};

		cmdline_mem: memory@ffd00000 {
			reg = <0x0 0xffd40000 0x0 0x1000>;
			no-map;
		};

		/*
		 * The modem's remote file system buffer. Stock allocates its 2 MiB at boot
		 * (qcom,sharedmem-uio, reg <0 0x200000>, client 1), so this one is dynamic too.
		 */
		rmtfs_mem: rmtfs {
			compatible = "qcom,rmtfs-mem";
			size = <0x0 0x200000>;
			alignment = <0x0 0x100000>;
			no-map;

			qcom,client-id = <1>;
			qcom,vmid = <QCOM_SCM_VMID_MSS_MSA>;
		};
	};

	/* The modem's SMP2P link: stock qcom,smp2p-modem (SMEM 435/428, SPI 70, APCS bit 14) */
	smp2p-mpss {
		compatible = "qcom,smp2p";
		qcom,smem = <435>, <428>;
		interrupts = <GIC_SPI 70 IRQ_TYPE_EDGE_RISING>;
		mboxes = <&apcs_glb 14>;
		qcom,local-pid = <0>;
		qcom,remote-pid = <1>;

		modem_smp2p_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <1>;
		};

		modem_smp2p_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};


};


&hsusb_phy1 {
	vdd-supply = <&vreg_l7a>;
	vdda-pll-supply = <&vreg_l10a>;
	vdda-phy-dpdm-supply = <&vreg_l15a>;
	status = "okay";
};

&pon_pwrkey {
	status = "okay";
};


&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		vreg_s6a: s6 {
			regulator-min-microvolt = <936000>;
			regulator-max-microvolt = <1422000>;
		};

		vreg_l1a: l1 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1256000>;
		};

		vreg_l2a: l2 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1056000>;
		};

		vreg_l3a: l3 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1064000>;
		};

		vreg_l4a: l4 {
			regulator-min-microvolt = <872000>;
			regulator-max-microvolt = <976000>;
			regulator-allow-set-load;
		};

		vreg_l5a: l5 {
			regulator-min-microvolt = <1648000>;
			regulator-max-microvolt = <2950000>;
			regulator-allow-set-load;
		};

		vreg_l6a: l6 {
			regulator-min-microvolt = <576000>;
			regulator-max-microvolt = <656000>;
		};

		vreg_l7a: l7 {
			regulator-min-microvolt = <872000>;
			regulator-max-microvolt = <976000>;
		};

		vreg_l8a: l8 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
		};

		vreg_l9a: l9 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1896000>;
		};

		vreg_l10a: l10 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1896000>;
			regulator-allow-set-load;
		};

		vreg_l11a: l11 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1952000>;
			regulator-allow-set-load;
		};

		vreg_l12a: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1996000>;
		};

		vreg_l13a: l13 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1832000>;
		};

		vreg_l14a: l14 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1904000>;
		};

		vreg_l15a: l15 {
			regulator-min-microvolt = <3104000>;
			regulator-max-microvolt = <3232000>;
		};

		vreg_l16a: l16 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1904000>;
		};

		vreg_l17a: l17 {
			regulator-min-microvolt = <1248000>;
			regulator-max-microvolt = <1304000>;
		};

		vreg_l18a: l18 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1264000>;
			regulator-allow-set-load;
		};

		vreg_l19a: l19 {
			regulator-min-microvolt = <1648000>;
			regulator-max-microvolt = <2952000>;
		};

		vreg_l20a: l20 {
			regulator-min-microvolt = <1648000>;
			regulator-max-microvolt = <2952000>;
		};

		vreg_l21a: l21 {
			regulator-min-microvolt = <2600000>;
			regulator-max-microvolt = <2856000>;
		};

		vreg_l22a: l22 {
			regulator-min-microvolt = <2944000>;
			regulator-max-microvolt = <2950000>;
			regulator-allow-set-load;
		};

		vreg_l23a: l23 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3400000>;
		};

		vreg_l24a: l24 {
			regulator-min-microvolt = <2944000>;
			regulator-max-microvolt = <2950000>;
			regulator-allow-set-load;
		};

	};
};



&sdhc_1 {
	vmmc-supply = <&vreg_l24a>;
	vqmmc-supply = <&vreg_l11a>;
	status = "okay";
};


/*
 * The unit stores on UFS, not eMMC: the stock partitions are /dev/block/sdaN (super is
 * sda6) and EDL reads it with --memory=ufs. Supplies as on laurel-sprout, the mainline
 * SM6125 board with UFS on the same PM6125 rails. Riposte OS (Linux) roots from userdata.
 */
&ufs_mem_hc {
	vcc-supply = <&vreg_l24a>;
	vccq2-supply = <&vreg_l11a>;
	vcc-max-microamp = <600000>;
	vccq2-max-microamp = <600000>;
	vdd-hba-supply = <&vreg_l18a>;
	status = "okay";
};

&ufs_mem_phy {
	vdda-phy-supply = <&vreg_l4a>;
	vdda-pll-supply = <&vreg_l10a>;
	status = "okay";
};

&tlmm {
	gpio-reserved-ranges = <22 2>, <28 6>;
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	/*
	 * Either role, switched from userspace: device by default, so the bench laptop stays the
	 * host (adb, the boot gadget); host when Riposte OS runs Android Auto with a phone on the
	 * cable: echo host > /sys/class/usb_role/<dwc3>-role-switch/role. No connector or extcon
	 * here, the unit's socket has no ID pin that Linux sees.
	 */
	dr_mode = "otg";
	usb-role-switch;
	role-switch-default-mode = "peripheral";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l18a>;
	status = "okay";

	panel@0 {
		compatible = "yuntang,s6d7aa0-720x1920";
		reg = <0>;

		reset-gpios = <&tlmm 90 GPIO_ACTIVE_LOW>;
		power-supply = <&panel_avdd>;
		vmipi-supply = <&panel_vmipi>;
		backlight = <&backlight>;
		rotation = <90>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	status = "okay";
};

/* Touch: Goodix GT9xx on SE2 (stock: i2c-1 0x14, irq GPIO 88, reset GPIO 87) */
&qupv3_id_0 {
	status = "okay";
};

&i2c2 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;

		interrupts-extended = <&tlmm 88 IRQ_TYPE_LEVEL_LOW>;
		irq-gpios = <&tlmm 88 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&tlmm 87 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * The MCU link: SE5 as a 2-wire UART on GPIO 24/25 (stock /dev/ttyHS1, qupv3_se5_2uart).
 * Mainline only describes SE5 as i2c5/spi5, so the UART node lives here.
 */
&qupv3_id_1 {
	status = "okay";

	mcu_uart: serial@4c80000 {
		compatible = "qcom,geni-uart";
		reg = <0x04c80000 0x4000>;
		clocks = <&gcc GCC_QUPV3_WRAP1_S0_CLK>;
		clock-names = "se";
		interrupts = <GIC_SPI 308 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&mcu_uart_default>;
		pinctrl-names = "default";
	};
};

&tlmm {
	mcu_uart_default: mcu-uart-default-state {
		pins = "gpio24", "gpio25";
		function = "qup10";
		drive-strength = <2>;
		bias-disable;
	};
};

/* pm6125.dtsi leaves USID 1 empty; the backlight PWM lives there */
&{/soc@0/spmi@1c40000/pmic@1} {
	#address-cells = <1>;
	#size-cells = <0>;

	pm6125_pwm: pwm {
		compatible = "qcom,pm6125-pwm";
		#pwm-cells = <2>;
	};
};

/*
 * Camera pipeline (os/mainline/CAMERA.md). Registers, interrupts, SMMU streams and CCI pins
 * from the stock device tree; clock names are SDM660's, mapped to SM6125's GCC clocks.
 */
&{/soc@0} {
	camss: camss@5c00020 {
		compatible = "qcom,sm6125-camss";
		reg = <0x05c00020 0x10>,
			      <0x05c30000 0x400>,
			      <0x05c30400 0x400>,
			      <0x05c30800 0x400>,
			      <0x05c30c00 0x400>,
			      <0x01628000 0x1000>,
			      <0x05c00120 0x4>,
			      <0x01629000 0x1000>,
			      <0x05c00124 0x4>,
			      <0x0162a000 0x1000>,
			      <0x05c00128 0x4>,
			      <0x05c31000 0xc00>,
			      <0x05c10000 0x4000>,
			      <0x05c14000 0x4000>;
		reg-names = "csi_clk_mux",
				    "csid0",
				    "csid1",
				    "csid2",
				    "csid3",
				    "csiphy0",
				    "csiphy0_clk_mux",
				    "csiphy1",
				    "csiphy1_clk_mux",
				    "csiphy2",
				    "csiphy2_clk_mux",
				    "ispif",
				    "vfe0",
				    "vfe1";
		interrupts = <GIC_SPI 208 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 209 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 210 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 211 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 72 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 73 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 74 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 212 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 214 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 215 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "csid0",
					  "csid1",
					  "csid2",
					  "csid3",
					  "csiphy0",
					  "csiphy1",
					  "csiphy2",
					  "ispif",
					  "vfe0",
					  "vfe1";
		clocks = <&gcc GCC_CAMSS_AHB_CLK_SRC>,
				 <&gcc GCC_CAMSS_CPHY_CSID0_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID1_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID2_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID3_CLK>,
				 <&gcc GCC_CAMSS_CSI0_AHB_CLK>,
				 <&gcc GCC_CAMSS_CSI0_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID0_CLK>,
				 <&gcc GCC_CAMSS_CSI0PIX_CLK>,
				 <&gcc GCC_CAMSS_CSI0RDI_CLK>,
				 <&gcc GCC_CAMSS_CSI1_AHB_CLK>,
				 <&gcc GCC_CAMSS_CSI1_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID1_CLK>,
				 <&gcc GCC_CAMSS_CSI1PIX_CLK>,
				 <&gcc GCC_CAMSS_CSI1RDI_CLK>,
				 <&gcc GCC_CAMSS_CSI2_AHB_CLK>,
				 <&gcc GCC_CAMSS_CSI2_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID2_CLK>,
				 <&gcc GCC_CAMSS_CSI2PIX_CLK>,
				 <&gcc GCC_CAMSS_CSI2RDI_CLK>,
				 <&gcc GCC_CAMSS_CSI3_AHB_CLK>,
				 <&gcc GCC_CAMSS_CSI3_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID3_CLK>,
				 <&gcc GCC_CAMSS_CSI3PIX_CLK>,
				 <&gcc GCC_CAMSS_CSI3RDI_CLK>,
				 <&gcc GCC_CAMSS_CSI0PHYTIMER_CLK>,
				 <&gcc GCC_CAMSS_CSI1PHYTIMER_CLK>,
				 <&gcc GCC_CAMSS_CSI2PHYTIMER_CLK>,
				 <&gcc GCC_CAMSS_CSIPHY0_CLK>,
				 <&gcc GCC_CAMSS_CSIPHY1_CLK>,
				 <&gcc GCC_CAMSS_CSIPHY2_CLK>,
				 <&gcc GCC_CAMSS_CSI_VFE0_CLK>,
				 <&gcc GCC_CAMSS_CSI_VFE1_CLK>,
				 <&gcc GCC_CAMSS_ISPIF_AHB_CLK>,
				 <&gcc GCC_CAMSS_THROTTLE_RT_AXI_CLK>,
				 <&gcc GCC_CAMSS_TOP_AHB_CLK>,
				 <&gcc GCC_CAMSS_VFE0_AHB_CLK>,
				 <&gcc GCC_CAMSS_VFE0_CLK>,
				 <&gcc GCC_CAMSS_VFE0_STREAM_CLK>,
				 <&gcc GCC_CAMSS_VFE1_AHB_CLK>,
				 <&gcc GCC_CAMSS_VFE1_CLK>,
				 <&gcc GCC_CAMSS_VFE1_STREAM_CLK>,
				 <&gcc GCC_CAMSS_VFE_VBIF_AHB_CLK>,
				 <&gcc GCC_CAMSS_VFE_VBIF_AXI_CLK>;
		clock-names = "ahb",
				      "cphy_csid0",
				      "cphy_csid1",
				      "cphy_csid2",
				      "cphy_csid3",
				      "csi0_ahb",
				      "csi0",
				      "csi0_phy",
				      "csi0_pix",
				      "csi0_rdi",
				      "csi1_ahb",
				      "csi1",
				      "csi1_phy",
				      "csi1_pix",
				      "csi1_rdi",
				      "csi2_ahb",
				      "csi2",
				      "csi2_phy",
				      "csi2_pix",
				      "csi2_rdi",
				      "csi3_ahb",
				      "csi3",
				      "csi3_phy",
				      "csi3_pix",
				      "csi3_rdi",
				      "csiphy0_timer",
				      "csiphy1_timer",
				      "csiphy2_timer",
				      "csiphy0",
				      "csiphy1",
				      "csiphy2",
				      "csi_vfe0",
				      "csi_vfe1",
				      "ispif_ahb",
				      "throttle_axi",
				      "top_ahb",
				      "vfe0_ahb",
				      "vfe0",
				      "vfe0_stream",
				      "vfe1_ahb",
				      "vfe1",
				      "vfe1_stream",
				      "vfe_ahb",
				      "vfe_axi";
		iommus = <&apps_smmu 0x420 0x0>,
			 <&apps_smmu 0x421 0x2>;
		power-domains = <&gcc CAMSS_VFE0_GDSC>,
				<&gcc CAMSS_VFE1_GDSC>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* CSIPHY 1: the PR2000, four lanes (stock laneAssign 0x4320) */
			port@1 {
				reg = <1>;

				camss_csiphy1_ep: endpoint {
					clock-lanes = <7>;
					data-lanes = <0 1 2 3>;
					remote-endpoint = <&pr2000_ep>;
				};
			};

			/* CSIPHY 2: the XS9922B, two lanes (stock laneAssign 0x20), VC 0..3 */
			port@2 {
				reg = <2>;

				camss_csiphy2_ep: endpoint {
					clock-lanes = <7>;
					data-lanes = <0 1>;
					remote-endpoint = <&xs9922b_ep>;
				};
			};
		};
	};

	cci: cci@5c0c000 {
		compatible = "qcom,msm8996-cci";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x05c0c000 0x4000>;
		interrupts = <GIC_SPI 207 IRQ_TYPE_EDGE_RISING>;
		assigned-clocks = <&gcc GCC_CAMSS_CCI_CLK>;
		assigned-clock-rates = <37500000>;
		clocks = <&gcc GCC_CAMSS_TOP_AHB_CLK>,
			 <&gcc GCC_CAMSS_CCI_AHB_CLK>,
			 <&gcc GCC_CAMSS_CCI_CLK>,
			 <&gcc GCC_CAMSS_AHB_CLK_SRC>;
		clock-names = "camss_top_ahb", "cci_ahb", "cci", "camss_ahb";
		pinctrl-0 = <&cci0_default &cci1_default>;
		pinctrl-names = "default";
		power-domains = <&gcc CAMSS_TOP_GDSC>;

		cci_i2c0: i2c-bus@0 {
			reg = <0>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* the four 360 cameras' decoder (stock: AIS slave 0x60, ID 0x9999) */
			video-decoder@30 {
				compatible = "xinshi,xs9922b";
				reg = <0x30>;

				port {
					xs9922b_ep: endpoint {
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <750000000>;
						remote-endpoint = <&camss_csiphy2_ep>;
					};
				};
			};
		};

		cci_i2c1: i2c-bus@1 {
			reg = <1>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* the reverse camera's decoder (stock: AIS slave 0xb8, ID 0x2000) */
			video-decoder@5c {
				compatible = "pixelplus,pr2000";
				reg = <0x5c>;
				reset-gpios = <&tlmm 115 GPIO_ACTIVE_LOW>;

				port {
					pr2000_ep: endpoint {
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <148500000>;
						remote-endpoint = <&camss_csiphy1_ep>;
					};
				};
			};
		};
	};
};

&tlmm {
	cci0_default: cci0-default-state {
		pins = "gpio37", "gpio38";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up;
	};

	cci1_default: cci1-default-state {
		pins = "gpio39", "gpio40";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up;
	};
};

/*
 * Wi-Fi + Bluetooth: a Qualcomm WCN3990-family combo chip (stock "qca,wcn3990" BT node, "qcom,icnss"
 * WLAN at 0xc800000, BT SoC property "cherokee"). The WLAN firmware runs inside the modem DSP,
 * so Wi-Fi needs the modem up first:
 *
 *   remoteproc mpss (modem.mdt) ──QMI──► wlan PD (wlanmdsp.mbn via tqftpserv) ◄──QMI── ath10k_snoc
 *
 * Every number here is the stock device tree's; the bindings are SM6115's, whose modem
 * resources (PAS id 4, crash SMEM 421, SSCTL 0x12) and WCN3990 rails match this SoC's.
 */
&{/soc@0} {
	remoteproc_mpss: remoteproc@6080000 {
		compatible = "qcom,sm6115-mpss-pas";
		reg = <0x06080000 0x100>;

		interrupts-extended = <&intc GIC_SPI 307 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 3 IRQ_TYPE_EDGE_RISING>,
				      <&modem_smp2p_in 7 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wdog", "fatal", "ready", "handover",
				  "stop-ack", "shutdown-ack";

		clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>;
		clock-names = "xo";

		power-domains = <&rpmpd SM6125_VDDCX>;

		memory-region = <&modem_mem>;
		firmware-name = "qcom/sm6125/choiceway/gt6eau/modem.mdt";

		qcom,smem-states = <&modem_smp2p_out 0>;
		qcom,smem-state-names = "stop";

		glink-edge {
			interrupts = <GIC_SPI 68 IRQ_TYPE_EDGE_RISING>;
			label = "mpss";
			qcom,remote-pid = <1>;
			mboxes = <&apcs_glb 12>;
		};
	};

	/* Stock qcom,icnss: same SPIs 358-369, SMMU stream 0x80, MSA at 0x53300000 */
	wifi: wifi@c800000 {
		compatible = "qcom,wcn3990-wifi";
		reg = <0x0c800000 0x800000>;
		reg-names = "membase";
		memory-region = <&wlan_msa_mem>;
		interrupts = <GIC_SPI 358 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 359 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 360 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 361 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 362 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 363 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 364 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 365 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 366 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 367 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 368 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 369 IRQ_TYPE_LEVEL_HIGH>;
		iommus = <&apps_smmu 0x80 0x1>;

		/* stock: vdd-cx-mx L8, vdd-1.8-xo L16, vdd-1.3-rfa L17, vdd-3.3-ch0 L23 */
		vdd-0.8-cx-mx-supply = <&vreg_l8a>;
		vdd-1.8-xo-supply = <&vreg_l16a>;
		vdd-1.3-rfa-supply = <&vreg_l17a>;
		vdd-3.3-ch0-supply = <&vreg_l23a>;

		/* stock qcom,wlan-msa-fixed-region: the firmware owns the MSA permissions */
		qcom,msa-fixed-perm;
	};
};

/*
 * Bluetooth: SE9 as a 4-wire UART on GPIO 10-13 (stock /dev/ttyHS0, qupv3_se9_4uart, SPI 312).
 * Mainline only describes SE9 as i2c9/spi9, so the UART node lives here.
 */
&qupv3_id_1 {
	bt_uart: serial@4c90000 {
		compatible = "qcom,geni-uart";
		reg = <0x04c90000 0x4000>;
		clocks = <&gcc GCC_QUPV3_WRAP1_S4_CLK>;
		clock-names = "se";
		interrupts = <GIC_SPI 312 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&bt_uart_default>;
		pinctrl-names = "default";

		/* stock bt_wcn3990: vdd-io L9, vdd-xtal L16, vdd-core L17, vdd-pa L23 */
		bluetooth {
			compatible = "qcom,wcn3990-bt";
			vddio-supply = <&vreg_l9a>;
			vddxo-supply = <&vreg_l16a>;
			vddrf-supply = <&vreg_l17a>;
			vddch0-supply = <&vreg_l23a>;
			max-speed = <3200000>;
		};
	};
};

&tlmm {
	/* stock pulls: CTS/RX none, RTS down, TX up */
	bt_uart_default: bt-uart-default-state {
		cts-rx-pins {
			pins = "gpio10", "gpio13";
			function = "qup14";
			drive-strength = <2>;
			bias-disable;
		};

		rts-pins {
			pins = "gpio11";
			function = "qup14";
			drive-strength = <2>;
			bias-pull-down;
		};

		tx-pins {
			pins = "gpio12";
			function = "qup14";
			drive-strength = <2>;
			bias-pull-up;
		};
	};
};

/*
 * Audio: the ADSP (LPASS QDSP6) runs the stock firmware, and the kernel talks to it over APR
 * (q6core, q6afe, q6asm, q6adm). The stock HAL sends every speaker stream to the secondary
 * MI2S port (audio_platform_info_intcodec.xml: SND_DEVICE_OUT_SPEAKER = SEC_MI2S_RX), one
 * data line out of the SoC to the car's audio chain, which the MCU switches and sets the
 * volume of (05 05 v). Nothing on that chain sits on a SoC bus, so the far end is a stand-in.
 *
 *   q6asm MultiMedia1-3 ──► q6adm routing ──► q6afe SECONDARY_MI2S_RX ──► GPIO 125-127 ──► amp/DSP
 *
 * The bindings come from SM6115 (Qualcomm RB2), whose LPASS shares this SoC's generation and
 * whose card drives the same port. Every number is the stock device tree's: PAS id 1, crash
 * SMEM 423, SSCTL 0x14, wdog SPI 396, glink SPI 391 on APCS bit 8, SMP2P SMEM 443/429 on
 * SPI 393 and APCS bit 10, audio stream 0x41.
 */
/ {
	/* stock qcom,smp2p-adsp */
	smp2p-adsp {
		compatible = "qcom,smp2p";
		qcom,smem = <443>, <429>;
		interrupts = <GIC_SPI 393 IRQ_TYPE_EDGE_RISING>;
		mboxes = <&apcs_glb 10>;
		qcom,local-pid = <0>;
		qcom,remote-pid = <2>;

		adsp_smp2p_out: master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <1>;
		};

		adsp_smp2p_in: slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <2>;
		};
	};

	/*
	 * The receiver on the I2S line: not on I2C, no MCLK pin, clocked by the SoC (stock
	 * qcom,msm-mi2s-master). A control-less transmitter stands in until the bench names it.
	 */
	audio_out: audio-codec {
		compatible = "linux,spdif-dit";
		#sound-dai-cells = <0>;
	};

	sound {
		compatible = "qcom,qrb4210-rb2-sndcard";
		model = "GT6-EAU";
		pinctrl-0 = <&sec_mi2s_active>;
		pinctrl-names = "default";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA1>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA2>;
			};
		};

		mm3-dai-link {
			link-name = "MultiMedia3";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA3>;
			};
		};

		car-dai-link {
			link-name = "Car Audio";

			cpu {
				sound-dai = <&q6afedai SECONDARY_MI2S_RX>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&audio_out>;
			};
		};

		/*
		 * Microphones: stock records WCD937x ADC1 (AMIC1) and ADC2 (INP3, AMIC3) → TX macro
		 * → TX_CDC_DMA_TX_3 (cdc-dma port 45115). The card waits for every link's
		 * components, so a macro or codec that fails to probe would take the speaker down
		 * with it. Both links stay off until the bench shows wcd937x bound (dmesg "bound
		 * sdw..."). Then set them to "okay" and add audio-routing = "AMIC1", "MIC BIAS1",
		 * "AMIC3", "MIC BIAS3" (stock's routes; a route to a codec outside the card fails
		 * the whole card, so not yet).
		 */
		mm4-dai-link {
			link-name = "MultiMedia4";
			status = "disabled";

			cpu {
				sound-dai = <&q6asmdai MSM_FRONTEND_DAI_MULTIMEDIA4>;
			};
		};

		mic-dai-link {
			link-name = "Microphone";
			status = "disabled";

			cpu {
				sound-dai = <&q6afedai TX_CODEC_DMA_TX_3>;
			};

			platform {
				sound-dai = <&q6routing>;
			};

			codec {
				sound-dai = <&wcd937x 1>, <&swr_tx 0>, <&txmacro 0>;
			};
		};
	};

	/*
	 * The SoC's codec. Stock: qcom,wcd937x-codec, reset GPIO 120, rx/tx/px from L9A and the
	 * buck from L14A (1.8 V each), micbias 1-3 at 1.8 V, slaves 0x...224 (RX) and 0x...223 (TX)
	 * on the macros' SoundWire masters. Stock names no mic-bias supply: Linux falls back to a
	 * dummy, and whether the bias reaches the car's mic is a bench question.
	 */
	wcd937x: audio-codec-1 {
		compatible = "qcom,wcd9370-codec";

		pinctrl-0 = <&wcd_reset_n>;
		pinctrl-names = "default";

		reset-gpios = <&tlmm 120 GPIO_ACTIVE_LOW>;

		vdd-buck-supply = <&vreg_l14a>;
		vdd-rxtx-supply = <&vreg_l9a>;
		vdd-px-supply = <&vreg_l9a>;

		qcom,micbias1-microvolt = <1800000>;
		qcom,micbias2-microvolt = <1800000>;
		qcom,micbias3-microvolt = <1800000>;

		qcom,rx-device = <&wcd937x_rx>;
		qcom,tx-device = <&wcd937x_tx>;

		#sound-dai-cells = <1>;
	};

	/*
	 * The macros' "fsgen" input. On SM8250 the VA macro's frame-sync generator feeds RX and
	 * TX; this SoC's bolero has no VA macro (stock qcom,va-without-decimation, 3 macros: RX,
	 * TX, WSA) and each macro gates its own MCLK. The drivers only enable fsgen, so an
	 * always-on clock stands in.
	 */
	lpass_fsgen: lpass-fsgen-clk {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <19200000>;
	};
};

&{/soc@0} {
	remoteproc_adsp: remoteproc@ab00000 {
		compatible = "qcom,sm6115-adsp-pas";
		reg = <0x0ab00000 0x100>;

		interrupts-extended = <&intc GIC_SPI 396 IRQ_TYPE_EDGE_RISING>,
				      <&adsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
				      <&adsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
				      <&adsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
				      <&adsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "wdog", "fatal", "ready",
				  "handover", "stop-ack";

		clocks = <&rpmcc RPM_SMD_XO_CLK_SRC>;
		clock-names = "xo";

		/* stock votes only vdd_cx; SM6125's RPM has no LPI domains */
		power-domains = <&rpmpd SM6125_VDDCX>;

		memory-region = <&adsp_pil_mem>;
		firmware-name = "qcom/sm6125/choiceway/gt6eau/adsp.mdt";

		qcom,smem-states = <&adsp_smp2p_out 0>;
		qcom,smem-state-names = "stop";

		glink-edge {
			interrupts = <GIC_SPI 391 IRQ_TYPE_EDGE_RISING>;
			label = "lpass";
			qcom,remote-pid = <2>;
			mboxes = <&apcs_glb 8>;

			apr {
				compatible = "qcom,apr-v2";
				qcom,glink-channels = "apr_audio_svc";
				qcom,domain = <APR_DOMAIN_ADSP>;
				#address-cells = <1>;
				#size-cells = <0>;

				service@3 {
					reg = <APR_SVC_ADSP_CORE>;
					compatible = "qcom,q6core";
					qcom,protection-domain = "avs/audio",
								 "msm/adsp/audio_pd";
				};

				q6afe: service@4 {
					compatible = "qcom,q6afe";
					reg = <APR_SVC_AFE>;
					qcom,protection-domain = "avs/audio",
								 "msm/adsp/audio_pd";

					q6afedai: dais {
						compatible = "qcom,q6afe-dais";
						#address-cells = <1>;
						#size-cells = <0>;
						#sound-dai-cells = <1>;

						/* stock qcom,msm-mi2s-rx-lines = <1>: SD0 only */
						dai@12 {
							reg = <SECONDARY_MI2S_RX>;
							qcom,sd-lines = <0>;
						};
					};

					q6afecc: clock-controller {
						compatible = "qcom,q6afe-clocks";
						#clock-cells = <2>;
					};
				};

				q6asm: service@7 {
					compatible = "qcom,q6asm";
					reg = <APR_SVC_ASM>;
					qcom,protection-domain = "avs/audio",
								 "msm/adsp/audio_pd";

					q6asmdai: dais {
						compatible = "qcom,q6asm-dais";
						#address-cells = <1>;
						#size-cells = <0>;
						#sound-dai-cells = <1>;
						/* stock qcom,msm-audio-ion */
						iommus = <&apps_smmu 0x41 0x0>;

						dai@0 {
							reg = <MSM_FRONTEND_DAI_MULTIMEDIA1>;
						};

						dai@1 {
							reg = <MSM_FRONTEND_DAI_MULTIMEDIA2>;
						};

						dai@2 {
							reg = <MSM_FRONTEND_DAI_MULTIMEDIA3>;
						};

						/* capture front end for the microphones */
						dai@3 {
							reg = <MSM_FRONTEND_DAI_MULTIMEDIA4>;
						};
					};
				};

				q6adm: service@8 {
					compatible = "qcom,q6adm";
					reg = <APR_SVC_ADM>;
					qcom,protection-domain = "avs/audio",
								 "msm/adsp/audio_pd";

					q6routing: routing {
						compatible = "qcom,q6adm-routing";
						#sound-dai-cells = <0>;
					};
				};
			};
		};
	};
};

&tlmm {
	/* stock sec_i2s_*_active: SCK 125, WS 126, SD0 127, SD1 128 (unused), 8 mA, no pulls */
	sec_mi2s_active: sec-mi2s-active-state {
		pins = "gpio125", "gpio126", "gpio127", "gpio128";
		function = "sec_mi2s";
		drive-strength = <8>;
		bias-disable;
	};

	/* stock rx_swr_*_active: CLK 110, DATA 111-112, 10 mA, bus hold */
	rx_swr_active: rx-swr-active-state {
		pins = "gpio110", "gpio111", "gpio112";
		function = "swr_rx";
		drive-strength = <10>;
		bias-bus-hold;
	};

	/* stock tx_swr_*_active: CLK 106, DATA 107-108, 10 mA, bus hold */
	tx_swr_active: tx-swr-active-state {
		pins = "gpio106", "gpio107", "gpio108";
		function = "swr_tx";
		drive-strength = <10>;
		bias-bus-hold;
	};

	/* stock wcd937x_reset_active: 16 mA */
	wcd_reset_n: wcd-reset-n-state {
		pins = "gpio120";
		function = "gpio";
		drive-strength = <16>;
		output-high;
	};
};

/*
 * Microphone path: the LPASS digital codec ("bolero") RX and TX macros, each with its own
 * SoundWire master, and the WCD937x's two SoundWire slaves on them. The layout is SM8250's
 * (TX macro owns the TX SoundWire, no VA decimators), not SM6115's, so the macros take the
 * sm8250 match data. Addresses, interrupts and clocks are the stock tree's: RX 0xa440000 +
 * SWR 0xa450000 (SPI 188), TX 0xa460000 + SWR 0xa470000 (SPI 184); q6afe clocks 0x30c/0x30d
 * (TX core/NPL) and 0x30e/0x30f (RX core/NPL). The drivers set both to 19.2 MHz.
 *
 *   AMIC1 ─► WCD937x ADC1 ─► TX SoundWire ─► TX macro DEC ─► TX_CODEC_DMA_TX_3 ─► MultiMedia4
 *
 * The RX side carries no audio here: the WCD937x driver binds only once both slaves are up.
 */
&{/soc@0} {
	rxmacro: codec@a440000 {
		compatible = "qcom,sm8250-lpass-rx-macro";
		reg = <0x0a440000 0x1000>;

		pinctrl-0 = <&rx_swr_active>;
		pinctrl-names = "default";

		clocks = <&q6afecc LPASS_CLK_ID_RX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_RX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&lpass_fsgen>;
		clock-names = "mclk", "npl", "dcodec", "fsgen";

		#clock-cells = <0>;
		clock-output-names = "mclk";
		#sound-dai-cells = <1>;
	};

	/* port setup copied from SM8250's RX master (5 ports, as stock qcom,swr-num-ports) */
	swr_rx: soundwire@a450000 {
		compatible = "qcom,soundwire-v1.5.1";
		reg = <0x0a450000 0x2000>;
		interrupts = <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH>;

		clocks = <&rxmacro>;
		clock-names = "iface";
		label = "RX";

		qcom,din-ports = <0>;
		qcom,dout-ports = <5>;

		qcom,ports-sinterval-low =	/bits/ 8 <0x03 0x1f 0x1f 0x07 0x00>;
		qcom,ports-offset1 =		/bits/ 8 <0x00 0x00 0x0b 0x01 0x00>;
		qcom,ports-offset2 =		/bits/ 8 <0x00 0x00 0x0b 0x00 0x00>;
		qcom,ports-hstart =		/bits/ 8 <0xff 0x03 0xff 0xff 0xff>;
		qcom,ports-hstop =		/bits/ 8 <0xff 0x06 0xff 0xff 0xff>;
		qcom,ports-word-length =	/bits/ 8 <0x01 0x07 0x04 0xff 0xff>;
		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0x00 0x01 0xff 0xff>;
		qcom,ports-lane-control =	/bits/ 8 <0x01 0x00 0x00 0x00 0x00>;
		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0x00>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		/* stock wcd937x-rx-slave, 0x1170224 */
		wcd937x_rx: codec@0,4 {
			compatible = "sdw20217010a00";
			reg = <0 4>;
			qcom,rx-port-mapping = <1 2 3 4 5>;
		};
	};

	txmacro: codec@a460000 {
		compatible = "qcom,sm8250-lpass-tx-macro";
		reg = <0x0a460000 0x1000>;

		pinctrl-0 = <&tx_swr_active>;
		pinctrl-names = "default";

		clocks = <&q6afecc LPASS_CLK_ID_TX_CORE_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_CLK_ID_TX_CORE_NPL_MCLK LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&q6afecc LPASS_HW_DCODEC_VOTE LPASS_CLK_ATTRIBUTE_COUPLE_NO>,
			 <&lpass_fsgen>;
		clock-names = "mclk", "npl", "dcodec", "fsgen";

		#clock-cells = <0>;
		clock-output-names = "mclk";
		#sound-dai-cells = <1>;
	};

	/* port setup copied from SM8250's TX master (5 ports, as stock) */
	swr_tx: soundwire@a470000 {
		compatible = "qcom,soundwire-v1.5.1";
		reg = <0x0a470000 0x2000>;
		interrupts = <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-names = "core";

		clocks = <&txmacro>;
		clock-names = "iface";
		label = "TX";

		qcom,din-ports = <5>;
		qcom,dout-ports = <0>;

		qcom,ports-sinterval-low =	/bits/ 8 <0xff 0x01 0x01 0x03 0x03>;
		qcom,ports-offset1 =		/bits/ 8 <0xff 0x01 0x00 0x02 0x00>;
		qcom,ports-offset2 =		/bits/ 8 <0xff 0x00 0x00 0x00 0x00>;
		qcom,ports-block-pack-mode =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-hstart =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-hstop =		/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-word-length =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-block-group-count =	/bits/ 8 <0xff 0xff 0xff 0xff 0xff>;
		qcom,ports-lane-control =	/bits/ 8 <0xff 0x00 0x01 0x00 0x01>;

		#sound-dai-cells = <1>;
		#address-cells = <2>;
		#size-cells = <0>;

		/* stock wcd937x-tx-slave, 0x1170223 */
		wcd937x_tx: codec@0,3 {
			compatible = "sdw20217010a00";
			reg = <0 3>;

			/* WCD port 1 ADC1, 2 ADC2/3, 3 DMIC0-3 + MBHC, 4 DMIC4-7 */
			qcom,tx-port-mapping = <1 1 2 3>;

			/*
			 * slave port channels in order adc1, adc2, adc3, mic0, dmic1, mbhc, dmic2,
			 * dmic3, dmic4, dmic5, dmic6, dmic7 (qcm6490-idp's WCD9370 mapping)
			 */
			qcom,tx-channel-mapping = /bits/ 8 <1 2 1 1 2 3 3 4 1 2 3 4>;
		};
	};
};
