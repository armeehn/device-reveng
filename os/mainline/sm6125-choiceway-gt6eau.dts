// SPDX-License-Identifier: BSD-3-Clause
/*
 * Choiceway GT6-EAU car head unit (Fibocom SC820/QCM6125), derived from
 * sm6125-xiaomi-ginkgo.dts by Gabriel Gonzales <semfault@disroot.org>.
 */

/dts-v1/;

#include <dt-bindings/arm/qcom,ids.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include "sm6125.dtsi"
#include "pm6125.dtsi"

/ {
	model = "Choiceway GT6-EAU";
	compatible = "choiceway,gt6-eau", "qcom,sm6125";
	chassis-type = "embedded";

	/* required for bootloader to select correct board */
	/*
	 * ABL must see an exact match for this board, or it applies the unit's downstream dtbo
	 * overlay to this DTB, fails ("Dtb overlay failed") and drops back to fastboot (bench,
	 * 2026-10-07). These are the car overlay's own IDs: QCM6125 (0x1d3) rev 1.0, board 0x22
	 * subtype 0; ABL then logs "Exact DTB match found. DTBO search is not required".
	 */
	qcom,msm-id = <0x1d3 0x10000>;
	qcom,board-id = <0x22 0>;

	aliases {
		serial1 = &mcu_uart;
	};

	chosen {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		framebuffer0: framebuffer@5c000000 {
			compatible = "simple-framebuffer";
			reg = <0 0x5c000000 0 (1920 * 720 * 4)>;
			width = <1920>;
			height = <720>;
			stride = <(1920 * 4)>;
			format = "a8r8g8b8";
		};
	};

	panel_avdd: regulator-panel-avdd {
		compatible = "regulator-fixed";
		regulator-name = "panel_avdd";
		gpio = <&tlmm 95 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <5000>;
	};

	panel_vmipi: regulator-panel-vmipi {
		compatible = "regulator-fixed";
		regulator-name = "panel_vmipi";
		gpio = <&tlmm 84 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		startup-delay-us = <5000>;
	};

	/*
	 * Stock: 12-bit levels on the PM6125 LPG, 100 us period, enable on GPIO 97.
	 * The default is half brightness; the stock 102/4095 reads as off in daylight.
	 */
	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pm6125_pwm 0 100000>;
		enable-gpios = <&tlmm 97 GPIO_ACTIVE_HIGH>;
		brightness-levels = <0 4095>;
		num-interpolated-steps = <4095>;
		default-brightness-level = <2048>;
	};

	reserved-memory {
		debug_mem: debug@ffb00000 {
			reg = <0x0 0xffb00000 0x0 0xc0000>;
			no-map;
		};

		last_log_mem: lastlog@ffbc0000 {
			reg = <0x0 0xffbc0000 0x0 0x80000>;
			no-map;
		};

		pstore_mem: ramoops@ffc00000 {
			compatible = "ramoops";
			reg = <0x0 0xffc40000 0x0 0xc0000>;
			record-size = <0x1000>;
			console-size = <0x40000>;
			pmsg-size = <0x20000>;
		};

		cmdline_mem: memory@ffd00000 {
			reg = <0x0 0xffd40000 0x0 0x1000>;
			no-map;
		};
	};


};


&hsusb_phy1 {
	vdd-supply = <&vreg_l7a>;
	vdda-pll-supply = <&vreg_l10a>;
	vdda-phy-dpdm-supply = <&vreg_l15a>;
	status = "okay";
};

&pon_pwrkey {
	status = "okay";
};


&rpm_requests {
	regulators-0 {
		compatible = "qcom,rpm-pm6125-regulators";

		vreg_s6a: s6 {
			regulator-min-microvolt = <936000>;
			regulator-max-microvolt = <1422000>;
		};

		vreg_l1a: l1 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1256000>;
		};

		vreg_l2a: l2 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1056000>;
		};

		vreg_l3a: l3 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1064000>;
		};

		vreg_l4a: l4 {
			regulator-min-microvolt = <872000>;
			regulator-max-microvolt = <976000>;
			regulator-allow-set-load;
		};

		vreg_l5a: l5 {
			regulator-min-microvolt = <1648000>;
			regulator-max-microvolt = <2950000>;
			regulator-allow-set-load;
		};

		vreg_l6a: l6 {
			regulator-min-microvolt = <576000>;
			regulator-max-microvolt = <656000>;
		};

		vreg_l7a: l7 {
			regulator-min-microvolt = <872000>;
			regulator-max-microvolt = <976000>;
		};

		vreg_l8a: l8 {
			regulator-min-microvolt = <400000>;
			regulator-max-microvolt = <728000>;
		};

		vreg_l9a: l9 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1896000>;
		};

		vreg_l10a: l10 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1896000>;
			regulator-allow-set-load;
		};

		vreg_l11a: l11 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1952000>;
			regulator-allow-set-load;
		};

		vreg_l12a: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1996000>;
		};

		vreg_l13a: l13 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1832000>;
		};

		vreg_l14a: l14 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1904000>;
		};

		vreg_l15a: l15 {
			regulator-min-microvolt = <3104000>;
			regulator-max-microvolt = <3232000>;
		};

		vreg_l16a: l16 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1904000>;
		};

		vreg_l17a: l17 {
			regulator-min-microvolt = <1248000>;
			regulator-max-microvolt = <1304000>;
		};

		vreg_l18a: l18 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1264000>;
			regulator-allow-set-load;
		};

		vreg_l19a: l19 {
			regulator-min-microvolt = <1648000>;
			regulator-max-microvolt = <2952000>;
		};

		vreg_l20a: l20 {
			regulator-min-microvolt = <1648000>;
			regulator-max-microvolt = <2952000>;
		};

		vreg_l21a: l21 {
			regulator-min-microvolt = <2600000>;
			regulator-max-microvolt = <2856000>;
		};

		vreg_l22a: l22 {
			regulator-min-microvolt = <2944000>;
			regulator-max-microvolt = <2950000>;
			regulator-allow-set-load;
		};

		vreg_l23a: l23 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3400000>;
		};

		vreg_l24a: l24 {
			regulator-min-microvolt = <2944000>;
			regulator-max-microvolt = <2950000>;
			regulator-allow-set-load;
		};

	};
};



&sdhc_1 {
	vmmc-supply = <&vreg_l24a>;
	vqmmc-supply = <&vreg_l11a>;
	status = "okay";
};


&tlmm {
	gpio-reserved-ranges = <22 2>, <28 6>;
};

&usb3 {
	status = "okay";
};

&usb3_dwc3 {
	/* the bench laptop is the host: adb and the boot gadget */
	dr_mode = "peripheral";
};

&mdss {
	status = "okay";
};

&mdss_dsi0 {
	vdda-supply = <&vreg_l18a>;
	status = "okay";

	panel@0 {
		compatible = "yuntang,s6d7aa0-720x1920";
		reg = <0>;

		reset-gpios = <&tlmm 90 GPIO_ACTIVE_LOW>;
		power-supply = <&panel_avdd>;
		vmipi-supply = <&panel_vmipi>;
		backlight = <&backlight>;
		rotation = <90>;

		port {
			panel_in: endpoint {
				remote-endpoint = <&mdss_dsi0_out>;
			};
		};
	};
};

&mdss_dsi0_out {
	remote-endpoint = <&panel_in>;
	data-lanes = <0 1 2 3>;
};

&mdss_dsi0_phy {
	status = "okay";
};

/* Touch: Goodix GT9xx on SE2 (stock: i2c-1 0x14, irq GPIO 88, reset GPIO 87) */
&qupv3_id_0 {
	status = "okay";
};

&i2c2 {
	clock-frequency = <400000>;
	status = "okay";

	touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;

		interrupts-extended = <&tlmm 88 IRQ_TYPE_LEVEL_LOW>;
		irq-gpios = <&tlmm 88 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&tlmm 87 GPIO_ACTIVE_HIGH>;
	};
};

/*
 * The MCU link: SE5 as a 2-wire UART on GPIO 24/25 (stock /dev/ttyHS1, qupv3_se5_2uart).
 * Mainline only describes SE5 as i2c5/spi5, so the UART node lives here.
 */
&qupv3_id_1 {
	status = "okay";

	mcu_uart: serial@4c80000 {
		compatible = "qcom,geni-uart";
		reg = <0x04c80000 0x4000>;
		clocks = <&gcc GCC_QUPV3_WRAP1_S0_CLK>;
		clock-names = "se";
		interrupts = <GIC_SPI 308 IRQ_TYPE_LEVEL_HIGH>;
		pinctrl-0 = <&mcu_uart_default>;
		pinctrl-names = "default";
	};
};

&tlmm {
	mcu_uart_default: mcu-uart-default-state {
		pins = "gpio24", "gpio25";
		function = "qup10";
		drive-strength = <2>;
		bias-disable;
	};
};

/* pm6125.dtsi leaves USID 1 empty; the backlight PWM lives there */
&{/soc@0/spmi@1c40000/pmic@1} {
	#address-cells = <1>;
	#size-cells = <0>;

	pm6125_pwm: pwm {
		compatible = "qcom,pm6125-pwm";
		#pwm-cells = <2>;
	};
};

/*
 * Camera pipeline (os/mainline/CAMERA.md). Registers, interrupts, SMMU streams and CCI pins
 * from the stock device tree; clock names are SDM660's, mapped to SM6125's GCC clocks.
 */
&{/soc@0} {
	camss: camss@5c00020 {
		compatible = "qcom,sm6125-camss";
		reg = <0x05c00020 0x10>,
			      <0x05c30000 0x400>,
			      <0x05c30400 0x400>,
			      <0x05c30800 0x400>,
			      <0x05c30c00 0x400>,
			      <0x01628000 0x1000>,
			      <0x05c00120 0x4>,
			      <0x01629000 0x1000>,
			      <0x05c00124 0x4>,
			      <0x0162a000 0x1000>,
			      <0x05c00128 0x4>,
			      <0x05c31000 0xc00>,
			      <0x05c10000 0x4000>,
			      <0x05c14000 0x4000>;
		reg-names = "csi_clk_mux",
				    "csid0",
				    "csid1",
				    "csid2",
				    "csid3",
				    "csiphy0",
				    "csiphy0_clk_mux",
				    "csiphy1",
				    "csiphy1_clk_mux",
				    "csiphy2",
				    "csiphy2_clk_mux",
				    "ispif",
				    "vfe0",
				    "vfe1";
		interrupts = <GIC_SPI 208 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 209 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 210 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 211 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 72 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 73 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 74 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 212 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 214 IRQ_TYPE_EDGE_RISING>,
				     <GIC_SPI 215 IRQ_TYPE_EDGE_RISING>;
		interrupt-names = "csid0",
					  "csid1",
					  "csid2",
					  "csid3",
					  "csiphy0",
					  "csiphy1",
					  "csiphy2",
					  "ispif",
					  "vfe0",
					  "vfe1";
		clocks = <&gcc GCC_CAMSS_AHB_CLK_SRC>,
				 <&gcc GCC_CAMSS_CPHY_CSID0_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID1_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID2_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID3_CLK>,
				 <&gcc GCC_CAMSS_CSI0_AHB_CLK>,
				 <&gcc GCC_CAMSS_CSI0_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID0_CLK>,
				 <&gcc GCC_CAMSS_CSI0PIX_CLK>,
				 <&gcc GCC_CAMSS_CSI0RDI_CLK>,
				 <&gcc GCC_CAMSS_CSI1_AHB_CLK>,
				 <&gcc GCC_CAMSS_CSI1_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID1_CLK>,
				 <&gcc GCC_CAMSS_CSI1PIX_CLK>,
				 <&gcc GCC_CAMSS_CSI1RDI_CLK>,
				 <&gcc GCC_CAMSS_CSI2_AHB_CLK>,
				 <&gcc GCC_CAMSS_CSI2_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID2_CLK>,
				 <&gcc GCC_CAMSS_CSI2PIX_CLK>,
				 <&gcc GCC_CAMSS_CSI2RDI_CLK>,
				 <&gcc GCC_CAMSS_CSI3_AHB_CLK>,
				 <&gcc GCC_CAMSS_CSI3_CLK>,
				 <&gcc GCC_CAMSS_CPHY_CSID3_CLK>,
				 <&gcc GCC_CAMSS_CSI3PIX_CLK>,
				 <&gcc GCC_CAMSS_CSI3RDI_CLK>,
				 <&gcc GCC_CAMSS_CSI0PHYTIMER_CLK>,
				 <&gcc GCC_CAMSS_CSI1PHYTIMER_CLK>,
				 <&gcc GCC_CAMSS_CSI2PHYTIMER_CLK>,
				 <&gcc GCC_CAMSS_CSIPHY0_CLK>,
				 <&gcc GCC_CAMSS_CSIPHY1_CLK>,
				 <&gcc GCC_CAMSS_CSIPHY2_CLK>,
				 <&gcc GCC_CAMSS_CSI_VFE0_CLK>,
				 <&gcc GCC_CAMSS_CSI_VFE1_CLK>,
				 <&gcc GCC_CAMSS_ISPIF_AHB_CLK>,
				 <&gcc GCC_CAMSS_THROTTLE_RT_AXI_CLK>,
				 <&gcc GCC_CAMSS_TOP_AHB_CLK>,
				 <&gcc GCC_CAMSS_VFE0_AHB_CLK>,
				 <&gcc GCC_CAMSS_VFE0_CLK>,
				 <&gcc GCC_CAMSS_VFE0_STREAM_CLK>,
				 <&gcc GCC_CAMSS_VFE1_AHB_CLK>,
				 <&gcc GCC_CAMSS_VFE1_CLK>,
				 <&gcc GCC_CAMSS_VFE1_STREAM_CLK>,
				 <&gcc GCC_CAMSS_VFE_VBIF_AHB_CLK>,
				 <&gcc GCC_CAMSS_VFE_VBIF_AXI_CLK>;
		clock-names = "ahb",
				      "cphy_csid0",
				      "cphy_csid1",
				      "cphy_csid2",
				      "cphy_csid3",
				      "csi0_ahb",
				      "csi0",
				      "csi0_phy",
				      "csi0_pix",
				      "csi0_rdi",
				      "csi1_ahb",
				      "csi1",
				      "csi1_phy",
				      "csi1_pix",
				      "csi1_rdi",
				      "csi2_ahb",
				      "csi2",
				      "csi2_phy",
				      "csi2_pix",
				      "csi2_rdi",
				      "csi3_ahb",
				      "csi3",
				      "csi3_phy",
				      "csi3_pix",
				      "csi3_rdi",
				      "csiphy0_timer",
				      "csiphy1_timer",
				      "csiphy2_timer",
				      "csiphy0",
				      "csiphy1",
				      "csiphy2",
				      "csi_vfe0",
				      "csi_vfe1",
				      "ispif_ahb",
				      "throttle_axi",
				      "top_ahb",
				      "vfe0_ahb",
				      "vfe0",
				      "vfe0_stream",
				      "vfe1_ahb",
				      "vfe1",
				      "vfe1_stream",
				      "vfe_ahb",
				      "vfe_axi";
		iommus = <&apps_smmu 0x420 0x0>,
			 <&apps_smmu 0x421 0x2>;
		power-domains = <&gcc CAMSS_VFE0_GDSC>,
				<&gcc CAMSS_VFE1_GDSC>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			/* CSIPHY 1: the PR2000, four lanes (stock laneAssign 0x4320) */
			port@1 {
				reg = <1>;

				camss_csiphy1_ep: endpoint {
					clock-lanes = <7>;
					data-lanes = <0 1 2 3>;
					remote-endpoint = <&pr2000_ep>;
				};
			};

			/* CSIPHY 2: the XS9922B, two lanes (stock laneAssign 0x20), VC 0..3 */
			port@2 {
				reg = <2>;

				camss_csiphy2_ep: endpoint {
					clock-lanes = <7>;
					data-lanes = <0 1>;
					remote-endpoint = <&xs9922b_ep>;
				};
			};
		};
	};

	cci: cci@5c0c000 {
		compatible = "qcom,msm8996-cci";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x05c0c000 0x4000>;
		interrupts = <GIC_SPI 207 IRQ_TYPE_EDGE_RISING>;
		assigned-clocks = <&gcc GCC_CAMSS_CCI_CLK>;
		assigned-clock-rates = <37500000>;
		clocks = <&gcc GCC_CAMSS_TOP_AHB_CLK>,
			 <&gcc GCC_CAMSS_CCI_AHB_CLK>,
			 <&gcc GCC_CAMSS_CCI_CLK>,
			 <&gcc GCC_CAMSS_AHB_CLK_SRC>;
		clock-names = "camss_top_ahb", "cci_ahb", "cci", "camss_ahb";
		pinctrl-0 = <&cci0_default &cci1_default>;
		pinctrl-names = "default";
		power-domains = <&gcc CAMSS_TOP_GDSC>;

		cci_i2c0: i2c-bus@0 {
			reg = <0>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* the four 360 cameras' decoder (stock: AIS slave 0x60, ID 0x9999) */
			video-decoder@30 {
				compatible = "xinshi,xs9922b";
				reg = <0x30>;

				port {
					xs9922b_ep: endpoint {
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <750000000>;
						remote-endpoint = <&camss_csiphy2_ep>;
					};
				};
			};
		};

		cci_i2c1: i2c-bus@1 {
			reg = <1>;
			clock-frequency = <400000>;
			#address-cells = <1>;
			#size-cells = <0>;

			/* the reverse camera's decoder (stock: AIS slave 0xb8, ID 0x2000) */
			video-decoder@5c {
				compatible = "pixelplus,pr2000";
				reg = <0x5c>;
				reset-gpios = <&tlmm 115 GPIO_ACTIVE_LOW>;

				port {
					pr2000_ep: endpoint {
						data-lanes = <1 2 3 4>;
						link-frequencies = /bits/ 64 <148500000>;
						remote-endpoint = <&camss_csiphy1_ep>;
					};
				};
			};
		};
	};
};

&tlmm {
	cci0_default: cci0-default-state {
		pins = "gpio37", "gpio38";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up;
	};

	cci1_default: cci1-default-state {
		pins = "gpio39", "gpio40";
		function = "cci_i2c";
		drive-strength = <2>;
		bias-pull-up;
	};
};
