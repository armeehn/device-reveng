+/* RDI lines per VFE that can carry their own virtual channel (RDI0..2) */
+#define ISPIF_VC_RDI_PER_VFE	3
+#define ISPIF_VC_MAX		3	/* CSI-2 VC is two bits */
+
+/*
+ * ispif_line_vc - CSI-2 virtual channel an ISPIF line reads
+ *
+ * VC 0 everywhere, unless the SoC sets vc_per_rdi: then VFE0 RDI0..2 read VC 0..2 and
+ * VFE1 RDI0 reads VC 3. PIX lines and anything past VC 3 stay on VC 0.
+ */
+static u8 ispif_line_vc(struct ispif_device *ispif, enum ispif_intf intf, u8 vfe)
+{
+	u8 rdi;
+
+	if (!ispif->camss->res->vc_per_rdi) {
+		return 0;
+	}
+
+	switch (intf) {
+	case RDI0:
+		rdi = 0;
+		break;
+	case RDI1:
+		rdi = 1;
+		break;
+	case RDI2:
+		rdi = 2;
+		break;
+	default:
+		return 0;
+	}
+
+	rdi += vfe * ISPIF_VC_RDI_PER_VFE;
+	return rdi <= ISPIF_VC_MAX ? rdi : 0;
+}
