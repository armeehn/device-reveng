# Choiceway GT6-EAU (QCM6125) on mainline: what defconfig leaves out for this board.
# Clocks and pins for the SoC.
CONFIG_SM_GCC_6125=y
CONFIG_PINCTRL_SM6125=y
# The bootloader's lit panel as a console (simple-framebuffer at 0x5c000000).
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# USB device mode for the bench laptop, built in so an initramfs needs no modules.
CONFIG_PHY_QCOM_QUSB2=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_NCM=y
# Storage, built in so a later rootfs mounts without modules.
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP_UFS=y
# The panel: DPU + DSI built in, the yuntang S6D7AA0 variant, a GPIO backlight.
CONFIG_SM_DISPCC_6125=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SAMSUNG_S6D7AA0=y
CONFIG_BACKLIGHT_GPIO=y
# DRM_MSM depends on these as "X || X=n": a module here caps it at a module too.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_COMMAND_DB=y
# Touch (Goodix on SE2) and the I2C it sits on, built in for the module-free initramfs.
CONFIG_I2C_QCOM_GENI=y
CONFIG_TOUCHSCREEN_GOODIX=y
# Backlight dimming: PM6125 LPG as a PWM, under pwm-backlight. LPG depends on QCOM_PBS as
# "X || !X" and uses the multicolor LED class, so both are built in too.
CONFIG_QCOM_PBS=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_BACKLIGHT_PWM=y
# Camera pipeline: camss (SM6125 entry from camss-sm6125.patch) and the CCI the decoders sit on.
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_PLATFORM_SUPPORT=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_I2C_QCOM_CCI=y
# The reverse camera decoder. Autoselect hides the I2C sub-driver menus, and a hidden
# prompt ignores a value set here, so it is off (it only picks tuners for USB TV sticks).
# CONFIG_MEDIA_SUBDRV_AUTOSELECT is not set
CONFIG_VIDEO_PR2000=y
