#!/bin/bash
# On x: copy the road noise takes zero collected from the head unit to the share.
#
#   zero:~/rav4-update/road-noise/ ──rsync, new files only──▶ <share>/road-noise/
#
# x pulls rather than zero pushing: x already reaches zero over the tailnet, and zero then
# holds no credential for x. Run by rav4-road-noise-collect.timer; a tick with zero offline
# does nothing. Nothing is deleted on either side, and a file already on the share is kept.
# Each new flat take is then filed as <day>/<sha16>.wav + index row, original to inbox-done/.
set -uo pipefail
# Site values (hosts, addresses, share paths) come from $RIPOSTE_OS_ENV, never from this
# file: the repo is public. os/riposte-os.env.example lists them.
RIPOSTE_OS_ENV=${RIPOSTE_OS_ENV:-/etc/riposte-os.env}
# shellcheck source=/dev/null
[ -r "$RIPOSTE_OS_ENV" ] && . "$RIPOSTE_OS_ENV"

ZERO=${ZERO:-${RIPOSTE_ZERO:?set RIPOSTE_ZERO}}
SRC=${SRC:-rav4-update/road-noise/}
DEST=${DEST:-${RIPOSTE_SHARE:?set RIPOSTE_SHARE}/road-noise}
OWNER=${OWNER:-sasha}
# Files each flat take into the contract layout the trainer reads (road-noise-file).
FILER=${FILER:-/usr/local/sbin/rav4-road-noise-file}

if ! timeout 15 ssh -o BatchMode=yes -o ConnectTimeout=8 "$ZERO" true 2>/dev/null; then
    echo "road noise: zero offline"
    exit 0
fi

mkdir -p "$DEST/inbox-done"
# Finished files only: road-noise-pull's *.part files are its own business. Takes already
# filed sit in inbox-done/, so they are excluded by name or every tick would copy them again.
done_list=$(mktemp)
trap 'rm -f "$done_list"' EXIT
find "$DEST/inbox-done" -maxdepth 1 -type f -printf '/%f\n' > "$done_list"
rsync -a --ignore-existing --exclude-from="$done_list" --include='*.wav' --include='*.json' \
    --exclude='*' -e "ssh -o BatchMode=yes" "$ZERO:$SRC" "$DEST/" || exit 1
python3 "$FILER" "$DEST" || exit 1
chown -R "$OWNER:$OWNER" "$DEST"
